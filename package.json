  "engines": {
    "node": ">=24.11.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start:all": "nx run-many --target=serve --projects=api,auth-service,salon-service,booking-service,notification-service,calendar-service,review-service,subscription-service,user-service,chat-service,web --parallel=11",
    "start:services": "nx run-many --target=serve --projects=api,auth-service,salon-service,booking-service,review-service,notification-service,calendar-service,subscription-service,user-service,chat-service --parallel",
    "start:frontend": "nx run web:serve",
    "test": "nx run-many --target=test --passWithNoTests --parallel=4",
    "test:services": "nx run-many --target=test --projects=auth-service,booking-service,subscription-service --passWithNoTests --parallel=3",
    "test:watch": "nx run-many --target=test --passWithNoTests --watch",
    "test:coverage": "nx run-many --target=test --passWithNoTests --parallel=4 --coverage",
    "test:e2e": "nx run-many --target=e2e --projects=booking-service-e2e --passWithNoTests",
    "test:all": "npm run test:services && npm run test:e2e",
    "test:ci": "nx run-many --target=test --passWithNoTests --parallel=4 --ci && nx run-many --target=e2e --projects=booking-service-e2e --passWithNoTests --ci",
    "test:affected": "nx affected --target=test --passWithNoTests",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "docker:build": "nx run-many --target=build --all --configuration=production",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose up -d --build",
    "compress:files": "tar -czf snapsalon_code.tar.gz --exclude=node_modules --exclude=dist --exclude=.git .",
    "kill-ports": "powershell -Command \"$ports = @(3000,3001,3002,3003,3004,3005,3006,3007,3008,3009,4200,9229); foreach($port in $ports) { $connections = Get-NetTCPConnection -LocalPort $port -ErrorAction SilentlyContinue; if($connections) { $connections | ForEach-Object { $processId = $_.OwningProcess; Write-Host \\\"Killing process $processId on port $port\\\" -ForegroundColor Yellow; Stop-Process -Id $processId -Force -ErrorAction SilentlyContinue } } }; Write-Host \\\"All ports cleared!\\\" -ForegroundColor Green\"",
    "mongo:migrate-cleanup": "node tools/scripts/mongo-cleanup-migration.js"
  },
  "private": true,
  "config": {
    "mongodbMemoryServer": {
      "downloadTimeout": 120000
    }
  },
