# ──────────────────────────────────────────────────────────
# SnapSalon Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ──────────────────────────────────────────────────────────

# ── JWT (shared across all services) ───────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-min-32-characters-long-access
JWT_REFRESH_SECRET=change-me-min-32-characters-long-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Internal service-to-service auth ──────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-min-32-chars

# ── Sentry (optional; server SDK skips when unset) ───────────────────────────
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ── Service Ports ──────────────────────────────────────────────────────────────
PORT=3000
AUTH_PORT=3003
USER_PORT=3008
SALON_PORT=3001
BOOKING_PORT=3002
NOTIFICATION_PORT=3004
CALENDAR_PORT=3005
REVIEW_PORT=3006
SUBSCRIPTION_PORT=3007

# ── CORS / Frontend ───────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# ── MongoDB URIs (one database per service; names match docker-compose defaults) ─
MONGODB_URI=mongodb://localhost:27017/snapsalon-auth
USER_MONGODB_URI=mongodb://localhost:27017/snapsalon-users
SALON_MONGODB_URI=mongodb://localhost:27017/snapsalon-salon
BOOKING_MONGODB_URI=mongodb://localhost:27017/snapsalon-booking
# calendar-service uses BOOKING_MONGODB_URI (read bookings) + CALENDAR_MONGODB_URI (Google tokens)
CALENDAR_MONGODB_URI=mongodb://localhost:27017/snapsalon-calendar
REVIEW_MONGODB_URI=mongodb://localhost:27017/snapsalon-reviews
SUBSCRIPTION_MONGODB_URI=mongodb://localhost:27017/snapsalon-subscriptions
NOTIFICATION_MONGODB_URI=mongodb://localhost:27017/snapsalon-notifications
# Production: use authenticated URIs, e.g.
# mongodb://user:password@host:27017/snapsalon-auth?authSource=admin
# For Docker mongo:7 with a new volume, set MONGO_INITDB_ROOT_USERNAME and
# MONGO_INITDB_ROOT_PASSWORD and point all URIs at that user (authSource=admin).

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Google OAuth (auth-service) ────────────────────────────────────────────────
AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3003/api/auth/google/callback

# ── Google Calendar (calendar-service) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3005/api/calendar/auth/callback

# ── Cloudinary (salon-service, auth-service, user-service) ────────────────────
CLOUDINARY_CLOUD_NAME=dl0iuki5h
CLOUDINARY_API_KEY=917297194919551
CLOUDINARY_API_SECRET=8AY4lxikxxG6J39L-XmcqOtiGIw

# ── SendGrid (notification-service) ────────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@snapsalon.lk
EMAIL_FROM_NAME=SnapSalon

# ── Firebase Cloud Messaging (notification-service) ────────────────────────────
# Firebase Admin SDK service account JSON (as single-line string)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project",...}

# ── Dialog SMS Gateway (notification-service) ──────────────────────────────────
DIALOG_SMS_API_KEY=your-dialog-api-key
DIALOG_SMS_BASE_URL=https://e-sms.dialog.lk/api/v2
SMS_SENDER_ID=SnapSalon

# ── WhatsApp Business Cloud API (notification-service) ─────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-api-token
# ── WhatsApp & Instagram Business API (chat-service) ───────────────────────────
# Meta WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token-min-32-chars
WHATSAPP_ACCESS_TOKEN=your-meta-graph-api-permanent-access-token
# WHATSAPP_PHONE_NUMBER_ID is shared with notification-service above

# Meta Instagram Business API
INSTAGRAM_PAGE_ACCESS_TOKEN=your-facebook-page-access-token-with-instagram-permissions
INSTAGRAM_VERIFY_TOKEN=your-custom-instagram-webhook-verify-token-min-32-chars

# ── APP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TEMPLATE_NAME=snapsalon_notification
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_BASE_URL=https://graph.facebook.com/v18.0

# ── PayHere (subscription-service) ─────────────────────────────────────────────
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_SECRET=your-merchant-secret
PAYHERE_RETURN_URL=http://localhost:4200/subscription/success
PAYHERE_CANCEL_URL=http://localhost:4200/subscription/cancel
PAYHERE_NOTIFY_URL=http://localhost:3007/api/subscriptions/webhook

# ── Inter-service URLs (used in docker-compose; override for local dev) ────────
# INTERNAL_TOKEN must match across services that call each other (auth internal APIs, etc.)
INTERNAL_TOKEN=change-me-in-production
AUTH_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3008
SALON_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3004
CALENDAR_SERVICE_URL=http://localhost:3005
REVIEW_SERVICE_URL=http://localhost:3006
SUBSCRIPTION_SERVICE_URL=http://localhost:3007
CHAT_SERVICE_URL=http://localhost:3009
