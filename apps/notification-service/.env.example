# ─────────────────────────────────────────────────────────────
#  SnapSalon — Notification Service  (.env or environment variables)
#
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

NOTIFICATION_PORT=3004

# MongoDB — dedicated notifications database
MONGODB_URI=mongodb://localhost:27017/snapsalon-notifications

# Redis — required for Bull queue consumption
REDIS_HOST=localhost
REDIS_PORT=6379

# API Gateway URL (for SSE push-back)
GATEWAY_URL=http://localhost:3000

# Internal service-to-service token — must match INTERNAL_TOKEN in api gateway
# If omitted in gateway, leave blank here too (open for local dev)
INTERNAL_TOKEN=change-me-in-production

# Upstream service URLs
AUTH_SERVICE_URL=http://localhost:3003
SALON_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3004

# E-mail (optional — service degrades gracefully without SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your-password
EMAIL_FROM=noreply@snapsalon.lk
