# ─────────────────────────────────────────────────────────────
#  SnapSalon — Notification Service  (.env or environment variables)
#
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Optional: SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

NOTIFICATION_PORT=3004

# MongoDB — dedicated notifications database
MONGODB_URI=mongodb://localhost:27017/snapsalon-notifications

# Redis — required for Bull queue consumption
REDIS_HOST=localhost
REDIS_PORT=6379

# API Gateway URL (for SSE push-back)
GATEWAY_URL=http://localhost:3000

# Internal service-to-service token — must match INTERNAL_TOKEN in api gateway
# If omitted in gateway, leave blank here too (open for local dev)
INTERNAL_TOKEN=change-me-in-production

# Upstream service URLs
AUTH_SERVICE_URL=http://localhost:3003
SALON_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3004

# ── Firebase Cloud Messaging (FCM) for push notifications ──────────────────────
# Firebase Admin SDK service account JSON (as single-line string)
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Never commit this to Git — copy the entire JSON as a single line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ── Email — SendGrid ───────────────────────────────────────────────────────────
# Get from: sendgrid.com → Settings → API Keys → Create API Key (Mail Send only)
# The EMAIL_FROM address must match a verified Sender Identity in SendGrid.
SENDGRID_API_KEY=SG.your-key-here
EMAIL_FROM=noreply@snapsalon.lk
EMAIL_FROM_NAME=SnapSalon
# Set to false to disable all outgoing emails (e.g. to avoid hitting SendGrid daily limits)
EMAIL_ENABLED=true

# ── Frontend URL (used in review-request email links) ─────────────────────────
FRONTEND_URL=https://snapsalon.lk
