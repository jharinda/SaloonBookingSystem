# Salon Service — copy to .env and fill in values
# Optional: SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SALON_PORT=3001
MONGO_URI=mongodb://localhost:27017/snapsalon-salon
REDIS_URL=redis://localhost:6379
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
