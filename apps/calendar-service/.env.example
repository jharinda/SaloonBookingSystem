# Calendar Service — copy to .env and fill in values
# Optional: SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
CALENDAR_PORT=3005
# Read-only: same database as booking-service (`bookings` collection)
BOOKING_MONGODB_URI=mongodb://localhost:27017/snapsalon-booking
# Google OAuth tokens (`googletokens` collection)
CALENDAR_MONGODB_URI=mongodb://localhost:27017/snapsalon-calendar
REDIS_URL=redis://localhost:6379
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token-min-32-chars
