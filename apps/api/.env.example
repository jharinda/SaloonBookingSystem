# ─────────────────────────────────────────────────────────────
#  SnapSalon — API Gateway  (.env or environment variables)
#
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Port the API Gateway listens on (default: 3000)
PORT=3000

# Optional — Sentry server DSN (omit for local dev)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# JWT secret shared between the gateway and every microservice
# Must match the secret used when signing tokens in auth-service
JWT_ACCESS_SECRET=change-me-min-32-characters-long-access

# Allowed CORS origin for the Angular app (default: http://localhost:4200)
CORS_ORIGIN=http://localhost:4200

# ── Internal service-to-service push token ────────────────────
# Shared with notification-service. If omitted, the /notifications/push
# endpoint runs open (fine for local dev; set in production).
INTERNAL_TOKEN=change-me-in-production

# ── Upstream microservice URLs (local dev defaults shown) ────
# These default to localhost if not set — only needed for Docker / production
AUTH_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3003
SALON_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:3002
REVIEW_SERVICE_URL=http://localhost:3006
CALENDAR_SERVICE_URL=http://localhost:3005
SUBSCRIPTION_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3004
CHAT_SERVICE_URL=http://localhost:3009
