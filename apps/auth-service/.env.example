# Auth Service — copy to .env and fill in values
# Optional: SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
AUTH_PORT=3003
MONGODB_URI=mongodb://localhost:27017/snapsalon-auth
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-replace-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
