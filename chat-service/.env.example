# ─────────────────────────────────────────────────────────────
#  SnapSalon — Chat Service  (.env or environment variables)
#
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Port the chat service listens on (default: 3009)
PORT=3009
CHAT_PORT=3009

# MongoDB — dedicated chat database
MONGODB_URI=mongodb://localhost:27017/snapsalon-chat

# Redis — required for Socket.io adapter and message queues
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT secret shared with auth-service for token validation
JWT_ACCESS_SECRET=change-me-min-32-characters-long-access

# ── Meta WhatsApp Business Cloud API ───────────────────────────────────────────
# Your custom secret for webhook verification (create a strong random string)
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token-min-32-chars

# Meta Graph API permanent access token for WhatsApp Business API
# Get from Meta Business Manager > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your-meta-graph-api-permanent-access-token

# WhatsApp Business phone number ID from Meta Business Manager
# Found in WhatsApp > API Setup > Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Meta Graph API base URL (default: v18.0)
WHATSAPP_BASE_URL=https://graph.facebook.com/v18.0

# ── Meta Instagram Business API ────────────────────────────────────────────────
# Facebook Page access token with instagram_manage_messages permission
# Get from Meta Business Manager > Instagram > Settings
INSTAGRAM_PAGE_ACCESS_TOKEN=your-facebook-page-access-token-with-instagram-permissions

# Your custom secret for Instagram webhook verification (create a strong random string)
INSTAGRAM_VERIFY_TOKEN=your-custom-instagram-webhook-verify-token-min-32-chars

# Instagram Graph API base URL (default: v18.0)
INSTAGRAM_BASE_URL=https://graph.facebook.com/v18.0

# ── Upstream service URLs ──────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3003
SALON_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3003
