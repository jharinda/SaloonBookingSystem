### Register a new user
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "test@gmail.com",
  "password": "Test@1234",
  "firstName": "Kasun",
  "lastName": "Perera",
  "role": "client"
}

### Login
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "test@gmail.com",
  "password": "Test@1234"
}

### Login as Admin
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin@1234"
}

### Login as Stylist
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "stylist@example.com",
  "password": "Stylist@1234"
}

POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin@1234",
  "firstName": "Super",
  "lastName": "Admin",
  "role": "admin"
}

### Register a stylist (basic)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "stylist@example.com",
  "password": "Stylist@1234",
  "firstName": "Jane",
  "lastName": "Smith",
  "role": "stylist"
}

### Register a stylist (with profile)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "email": "stylist2@example.com",
  "password": "Stylist@1234",
  "firstName": "Sarah",
  "lastName": "Johnson",
  "role": "stylist",
  "stylistProfile": {
    "bio": "Professional hair stylist with 7 years of experience specializing in modern cuts and color.",
    "specialties": ["Haircuts", "Hair Coloring", "Balayage", "Keratin Treatment"],
    "yearsExperience": 7,
    "workingHours": [
      { "day": 1, "start": "09:00", "end": "17:00", "isOff": false },
      { "day": 2, "start": "09:00", "end": "17:00", "isOff": false },
      { "day": 3, "start": "09:00", "end": "17:00", "isOff": false },
      { "day": 4, "start": "09:00", "end": "17:00", "isOff": false },
      { "day": 5, "start": "09:00", "end": "17:00", "isOff": false },
      { "day": 6, "start": "10:00", "end": "14:00", "isOff": false },
      { "day": 0, "start": "00:00", "end": "00:00", "isOff": true }
    ]
  }
}

### Push test SSE notification
### Push test SSE notification
POST http://localhost:3000/api/notifications/push
Content-Type: application/json
X-Internal-Token: dev-secret-token-123

{
  "userId": "69a6ad2a9e30218e0681ee79",
  "event": "booking.new",
  "data": {
    "bookingId": "test-001",
    "clientName": "Kasun Perera",
    "serviceName": "Haircut",
