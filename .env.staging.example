# SnapSalon — staging environment template (no secrets committed).
# Copy to .env.staging for local use, or set equivalent vars per service in Render / your host.
# Replace <placeholders> and values marked set-in-dashboard.

NODE_ENV=staging

# ── Sentry (optional) ──
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ── API Gateway ──
PORT=3000
CORS_ORIGIN=https://staging.snapsalon.lk
JWT_ACCESS_SECRET=<set-in-render-dashboard>

# ── MongoDB ──
# Use MongoDB Atlas staging cluster (one URI per DB; map to each service’s env in the dashboard).
MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-auth
SALON_MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-salon
BOOKING_MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-booking
NOTIFICATION_MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-notifications
REVIEW_MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-reviews
CALENDAR_MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-calendar
SUBSCRIPTION_MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-subscriptions
USER_MONGODB_URI=mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/snapsalon-users

# ── Redis ──
# Use Upstash Redis for staging (TLS).
REDIS_HOST=<upstash-endpoint>
REDIS_PORT=6379
REDIS_PASSWORD=<upstash-password>
REDIS_TLS=true

# ── PayHere ──
# Use PayHere SANDBOX for staging.
PAYHERE_MERCHANT_ID=<sandbox-merchant-id>
PAYHERE_SECRET=<sandbox-secret>

# ── SendGrid ──
SENDGRID_API_KEY=<staging-key>

# ── Frontend ──
FRONTEND_URL=https://staging.snapsalon.lk
